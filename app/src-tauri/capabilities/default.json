{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main ImageGen window: gateway HTTP calls (any host — the gateway URL is user-configured at runtime, so the http:default scope stays host-agnostic rather than allowlisting it by name), library file access under ~/Pictures/ImageGen, and revealing library files in Finder (opener:default). The .imagegen entries are NOT redundant with the ** globs: tauri-plugin-fs defaults require_literal_leading_dot to true on unix, so ** never matches a dot-prefixed component.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "log:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*" }, { "url": "https://*:*" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$PICTURE/ImageGen" },
        { "path": "$PICTURE/ImageGen/**" },
        { "path": "$PICTURE/ImageGen/.imagegen" },
        { "path": "$PICTURE/ImageGen/.imagegen/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$PICTURE/ImageGen" },
        { "path": "$PICTURE/ImageGen/**" },
        { "path": "$PICTURE/ImageGen/.imagegen" },
        { "path": "$PICTURE/ImageGen/.imagegen/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$PICTURE/ImageGen" },
        { "path": "$PICTURE/ImageGen/**" },
        { "path": "$PICTURE/ImageGen/.imagegen" },
        { "path": "$PICTURE/ImageGen/.imagegen/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$PICTURE/ImageGen" },
        { "path": "$PICTURE/ImageGen/**" },
        { "path": "$PICTURE/ImageGen/.imagegen" },
        { "path": "$PICTURE/ImageGen/.imagegen/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$PICTURE/ImageGen" },
        { "path": "$PICTURE/ImageGen/**" },
        { "path": "$PICTURE/ImageGen/.imagegen" },
        { "path": "$PICTURE/ImageGen/.imagegen/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$PICTURE/ImageGen" },
        { "path": "$PICTURE/ImageGen/**" },
        { "path": "$PICTURE/ImageGen/.imagegen" },
        { "path": "$PICTURE/ImageGen/.imagegen/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$PICTURE/ImageGen" },
        { "path": "$PICTURE/ImageGen/**" },
        { "path": "$PICTURE/ImageGen/.imagegen" },
        { "path": "$PICTURE/ImageGen/.imagegen/**" }
      ]
    }
  ]
}
